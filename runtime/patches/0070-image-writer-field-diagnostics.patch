     for (size_t i = 0; i < dex_cache->NumResolvedFields(); i++) {
-      ArtField* field = dex_cache->GetResolvedField(i, target_ptr_size_);
+      // Read the raw element: GetResolvedField() returns nullptr for fields of
+      // erroneous declaring classes, which would leave a dangling ArtField in
+      // the array once the class is pruned and reclaimed (q20-android: quickened
+      // dex makes the verifier reject some boot classes as erroneous).
+      ArtField* field = dex_cache->GetResolvedFields()->GetElementPtrSize<ArtField*>(
+          i, target_ptr_size_);
       if (field != nullptr && !IsImageClass(field->GetDeclaringClass())) {
         dex_cache->SetResolvedField(i, nullptr, target_ptr_size_);
       }
@@ -1153,9 +1153,40 @@
