 static jobject ICU_getAvailableCurrencyCodes(JNIEnv* env, jclass) {
   UErrorCode status = U_ZERO_ERROR;
+#if U_ICU_VERSION_MAJOR_NUM >= 49
   icu::UStringEnumeration e(ucurr_openISOCurrencies(UCURR_COMMON|UCURR_NON_DEPRECATED, &status));
   return fromStringEnumeration(env, status, "ucurr_openISOCurrencies", &e);
+#else
+  // q20-android: ICU 4.6 has no icu::UStringEnumeration; walk the C enumeration.
+  UEnumeration* e = ucurr_openISOCurrencies(UCURR_COMMON|UCURR_NON_DEPRECATED, &status);
+  if (maybeThrowIcuException(env, "ucurr_openISOCurrencies", status)) {
+    return NULL;
+  }
+  int32_t count = uenum_count(e, &status);
+  jobjectArray result = U_SUCCESS(status) ? env->NewObjectArray(count, JniConstants::stringClass, NULL) : NULL;
+  for (int32_t i = 0; result != NULL && i < count; ++i) {
+    const char* code = uenum_next(e, NULL, &status);
+    if (maybeThrowIcuException(env, "uenum_next", status)) {
+      result = NULL;
+      break;
+    }
+    ScopedLocalRef<jstring> javaCode(env, env->NewStringUTF(code));
+    env->SetObjectArrayElement(result, i, javaCode.get());
+  }
+  uenum_close(e);
+  return result;
+#endif
 }
 
