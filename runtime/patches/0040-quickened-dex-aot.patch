Accept quickened dex input in dex2oat for the QNX boot image rebuild (q20-android research)

The factory boot dexes are quickened (invoke-virtual-quick and the iget/iput
quick opcodes). The verifier cannot recover the original method or field
index from a quickened instruction when the receiver register type has no
class (provably null, unresolved, or conflict): the method index is replaced
by a vtable index and the field index by an offset. Such an access throws NPE
at runtime and never completes normally, so accept it conservatively instead
of rejecting the class: the invoke result is left unknown, and a quick get
sets the destination register to Conflict. Without this, classes containing
quickened accesses on a provably null receiver (e.g.
android.icu.impl.PluralRulesLoader.<clinit> and four android.icu.text format
classes) fail verification both in dex2oat and at runtime.

--- a/art/runtime/verifier/method_verifier.cc
+++ b/art/runtime/verifier/method_verifier.cc
@@ -903,7 +903,10 @@
       result = false;
       break;
   }
-  if (inst->GetVerifyIsRuntimeOnly() && Runtime::Current()->IsAotCompiler() && !verify_to_dump_) {
+  // QNX port: accept quickened dex input in AOT mode (boot image rebuild from
+  // a quickened factory boot.oat). The quick opcodes are handled by
+  // GetQuickInvokedMethod / GetQuickFieldAccess below.
+  if (inst->GetVerifyIsRuntimeOnly() && !verify_to_dump_ && false) {
     Fail(VERIFY_ERROR_BAD_CLASS_HARD) << "opcode only expected at runtime " << inst->Name();
     result = false;
   }
@@ -3573,11 +3576,19 @@
 }
 
 ArtMethod* MethodVerifier::VerifyInvokeVirtualQuickArgs(const Instruction* inst, bool is_range) {
-  DCHECK(Runtime::Current()->IsStarted() || verify_to_dump_)
+  DCHECK(Runtime::Current()->IsStarted() || verify_to_dump_ || Runtime::Current()->IsAotCompiler())
       << PrettyMethod(dex_method_idx_, *dex_file_, true) << "@" << work_insn_idx_;
 
   ArtMethod* res_method = GetQuickInvokedMethod(inst, work_line_.get(), is_range, false);
   if (res_method == nullptr) {
+    if (!have_pending_hard_failure_) {
+      // The receiver register has no class (null, unresolved, or conflict):
+      // the original method index is unrecoverable from a quickened invoke,
+      // but such an invoke throws NPE at runtime and never returns normally
+      // (q20-android: the boot dexes are quickened and we must verify them).
+      // Accept conservatively; the caller leaves the result register unknown.
+      return nullptr;
+    }
     Fail(VERIFY_ERROR_BAD_CLASS_HARD) << "Cannot infer method from " << inst->Name();
     return nullptr;
   }
@@ -4098,10 +4109,20 @@
 template <MethodVerifier::FieldAccessType kAccType>
 void MethodVerifier::VerifyQuickFieldAccess(const Instruction* inst, const RegType& insn_type,
                                             bool is_primitive) {
-  DCHECK(Runtime::Current()->IsStarted() || verify_to_dump_);
+  DCHECK(Runtime::Current()->IsStarted() || verify_to_dump_ || Runtime::Current()->IsAotCompiler());
 
   ArtField* field = GetQuickFieldAccess(inst, work_line_.get());
   if (field == nullptr) {
+    if (!have_pending_hard_failure_) {
+      // The object register has no class (null, unresolved, or conflict): the
+      // field offset is unrecoverable from a quickened access, and the access
+      // throws NPE at runtime (q20-android: verifying quickened boot dexes).
+      // Accept conservatively.
+      if (kAccType == FieldAccessType::kAccGet) {
+        work_line_->SetRegisterType(this, inst->VRegA_22c(), reg_types_.Conflict());
+      }
+      return;
+    }
     Fail(VERIFY_ERROR_BAD_CLASS_HARD) << "Cannot infer field from " << inst->Name();
     return;
   }


