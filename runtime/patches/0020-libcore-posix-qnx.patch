     Passwd(JNIEnv* env) : mEnv(env), mResult(NULL) {
         mBufferSize = sysconf(_SC_GETPW_R_SIZE_MAX);
+#if defined(__QNXNTO__)
+        // QNX sysconf returns -1 for _SC_GETPW_R_SIZE_MAX; use a sane bound.
+        if (mBufferSize == static_cast<long>(-1) || mBufferSize > 16384) {
+            mBufferSize = 4096;
+        }
+#endif
         mBuffer.reset(new char[mBufferSize]);
     }
 
